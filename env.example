# Supabase public read connection (safe for browser use; keep RLS enabled)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase central database connection (SERVER-SIDE ONLY)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret used only by the admin when publishing the Master Excel module list.
ADMIN_SYNC_TOKEN=change-this-to-a-long-random-secret

SUPABASE_SECRET_KEY=
