# Browser-safe Supabase read (Vite exposes only VITE_* automatically; NEXT_PUBLIC_* is also supported by vite.config.js)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-side central module sync (keep secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy alternative, if your Supabase project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ADMIN_SYNC_TOKEN=replace-with-your-private-admin-token
